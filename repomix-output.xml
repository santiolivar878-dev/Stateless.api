<file path="src/main/resources/templates/checkout/index.html">
<div th:replace="~{layouts/app-layout :: layout(content=~{::section})}">
<section style="padding: 60px; max-width: 1000px; margin: 0 auto;">
    <h1 style="font-family:'Bebas Neue', sans-serif; font-size:48px; letter-spacing:4px; margin-bottom:8px;">CHECKOUT</h1>
    <p style="font-size:13px; opacity:0.5; margin-bottom:40px;">Completa tu pedido</p>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:60px;">
        <!-- FORMULARIO -->
        <div>
            <h2 style="font-family:'Bebas Neue', sans-serif; font-size:24px; margin-bottom:24px;">DATOS DE ENVÍO</h2>
            <form id="checkout-form">
                <div style="margin-bottom:20px;">
                    <label class="sl-label">Dirección</label>
                    <input type="text" id="direccion" name="direccion" class="sl-input" required>
                </div>
                <div style="margin-bottom:20px;">
                    <label class="sl-label">Ciudad</label>
                    <input type="text" id="ciudad" name="ciudad" class="sl-input" required>
                </div>

                <h2 style="font-family:'Bebas Neue', sans-serif; font-size:24px; margin-top:32px; margin-bottom:24px;">MÉTODO DE PAGO</h2>
                
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:24px;">
                    <label id="opt-tarjeta" onclick="seleccionarMetodo('tarjeta')" style="border:2px solid #000; padding:16px; cursor:pointer; text-align:center;">
                        <p>💳 Tarjeta</p>
                    </label>
                    <label id="opt-efecty" onclick="seleccionarMetodo('efecty')" style="border:1px solid #ddd; padding:16px; cursor:pointer; text-align:center;">
                        <p>💵 Efecty</p>
                    </label>
                </div>

                <button type="submit" id="submit-btn" class="btn-stateless" style="width:100%; padding:16px;">
                    Pagar <span th:text="${'$' + #numbers.formatDecimal(carrito.total, 0, 'COMMA', 2, 'POINT')}"></span>
                </button>
            </form>
        </div>

        <!-- RESUMEN (Derecha) -->
        <div>
            <h2 style="font-family:'Bebas Neue', sans-serif; font-size:24px; margin-bottom:24px;">RESUMEN</h2>
            <div th:each="item : ${carrito.items}" style="display:flex; justify-content:space-between; padding:12px 0; border-bottom:1px solid #eee;">
                <div>
                    <p th:text="${item.producto.nombre}" style="font-size:13px; font-weight:600;"></p>
                    <p th:text="${'Cantidad: ' + item.cantidad}" style="font-size:12px; opacity:0.5;"></p>
                </div>
                <p th:text="${'$' + item.subtotal}" style="font-size:13px; font-weight:600;"></p>
            </div>
            <div style="display:flex; justify-content:space-between; padding:20px 0; border-top:2px solid #000; margin-top:8px;">
                <p style="font-family:'Bebas Neue', sans-serif; font-size:20px;">TOTAL</p>
                <p th:text="${'$' + #numbers.formatDecimal(carrito.total, 0, 'COMMA', 2, 'POINT')}" style="font-family:'Bebas Neue', sans-serif; font-size:20px;"></p>
            </div>
        </div>
    </div>
</section>

<script th:inline="javascript">
    let metodoSeleccionado = 'tarjeta';

    function seleccionarMetodo(metodo) {
        metodoSeleccionado = metodo;
        document.getElementById('opt-tarjeta').style.border = metodo === 'tarjeta' ? '2px solid #000' : '1px solid #ddd';
        document.getElementById('opt-efecty').style.border = metodo === 'efecty' ? '2px solid #000' : '1px solid #ddd';
    }

    document.getElementById('checkout-form').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const btn = document.getElementById('submit-btn');
        btn.disabled = true;
        btn.textContent = 'Procesando...';

        const response = await fetch('/checkout/procesar', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content
            },
            body: JSON.stringify({
                direccion: document.getElementById('direccion').value,
                ciudad: document.getElementById('ciudad').value,
                metodo_pago: metodoSeleccionado
            })
        });

        const data = await response.json();
        if (data.redirect) window.location.href = data.redirect;
    });
</script>
</div>
</file>

<file path="src/main/resources/templates/empleado/inventario/index.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" th:replace="~{layouts/admin-layout :: layout(content=~{::section})}">
<body>
<section>
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <h2 style="font-family:'Bebas Neue', sans-serif; font-size:32px; letter-spacing:3px;">Control de Inventario</h2>
        
        <!-- Filtro por Categoría -->
        <form method="GET" th:action="@{/empleado/inventario}" style="display:flex; gap:10px;">
            <select name="categoriaId" class="sl-input" onchange="this.form.submit()" style="width:200px;">
                <option value="">Todas las categorías</option>
                <option th:each="c : ${categorias}" 
                        th:value="${c.id}" 
                        th:text="${c.nombre}"
                        th:selected="${c.id == categoriaSeleccionada}"></option>
            </select>
        </form>
    </div>

    <div th:if="${success}" class="alert-success-sl" th:text="${success}"></div>

    <table class="stateless-table">
        <thead>
            <tr>
                <th>Ref</th>
                <th>Producto</th>
                <th>Estado Stock</th>
                <th>Mínimo</th>
                <th>Stock Actual</th>
                <th>Acción Rápida</th>
            </tr>
        </thead>
        <tbody>
            <tr th:each="p : ${productos}">
                <td th:text="${p.id}" style="opacity:0.5;"></td>
                <td>
                    <div style="display:flex; align-items:center; gap:12px;">
                        <img th:if="${p.imagen}" th:src="@{'/images/' + ${p.imagen}}" style="width:40px; height:50px; object-fit:cover;">
                        <div>
                            <p th:text="${p.nombre}" style="font-weight:600; margin:0;"></p>
                            <p th:text="${p.categoria.nombre}" style="font-size:10px; opacity:0.5; margin:0; text-transform:uppercase;"></p>
                        </div>
                    </div>
                </td>
                <td>
                    <!-- Badge de alerta de stock (Lógica Laravel replicada) -->
                    <span th:if="${p.stockActual == 0}" style="background:#c00; color:#fff; padding:2px 8px; font-size:10px;">AGOTADO</span>
                    <span th:if="${p.stockActual > 0 && p.stockActual <= p.stockMinimo}" style="background:#f90; color:#000; padding:2px 8px; font-size:10px;">STOCK BAJO</span>
                    <span th:if="${p.stockActual > p.stockMinimo}" style="background:green; color:#fff; padding:2px 8px; font-size:10px;">DISPONIBLE</span>
                </td>
                <td th:text="${p.stockMinimo}"></td>
                <td th:text="${p.stockActual}" th:style="${p.stockActual <= p.stockMinimo ? 'color:#c00; font-weight:700;' : ''}"></td>
                <td>
                    <!-- Formulario de actualización rápida -->
                    <form th:action="@{'/empleado/inventario/update-stock/' + ${p.id}}" method="POST" style="display:flex; gap:5px;">
                        <input type="number" name="cantidad" th:value="${p.stockActual}" min="0" 
                               style="width:60px; padding:4px; border:1px solid #ddd; font-size:12px;">
                        <button type="submit" class="btn-sl" style="padding:4px 10px; font-size:10px;">Actualizar</button>
                    </form>
                </td>
            </tr>
        </tbody>
    </table>
</section>
</body>
</html>
</file>

