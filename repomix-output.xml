<file path="src/main/resources/templates/layouts/guest-layout.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>STATELESS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.bunny.net/css?family=bebas-neue&display=swap" rel="stylesheet" />
    <link rel="stylesheet" th:href="@{/css/styles.css}">
    <style>
        /* Replicando el CSS exacto de tu guest.blade.php */
        body { background:#000; margin:0; overflow-x:hidden; font-family:'Inter', sans-serif; }
        #wavesCanvas { position:fixed; top:0; left:0; width:100%; height:100%; z-index:0; }
        .auth-brand { position:fixed; top:24px; left:32px; color:#fff; font-family:'Bebas Neue', sans-serif; font-size:22px; letter-spacing:3px; z-index:2; }
        .auth-card { position:relative; z-index:2; background:rgba(0,0,0,0.55); border:1px solid rgba(255,255,255,0.15); padding:40px 36px; width:100%; max-width:380px; backdrop-filter:blur(6px); }
        .auth-card label { color:rgba(255,255,255,0.7); font-size:11px; letter-spacing:1px; text-transform:uppercase; margin-bottom:6px; display:block; }
        .auth-card .form-control { width:100%; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.2); color:#fff; padding:10px 12px; margin-bottom:16px; font-size:13px; border-radius:0; }
        .btn-stateless { width:100%; background:#fff; color:#000; border:none; padding:12px; font-family:'Bebas Neue', sans-serif; letter-spacing:2px; font-size:14px; cursor:pointer; border-radius:0; text-decoration:none; display:block; text-align:center; }
        .subtitle { color:rgba(255,255,255,0.5); font-size:12px; margin:0 0 24px; }
        h2 { font-family:'Bebas Neue', sans-serif; color:#fff; font-size:28px; letter-spacing:2px; margin:0 0 4px; }
    </style>
</head>
<body>
    <canvas id="wavesCanvas"></canvas>
    <div class="auth-brand"><a th:href="@{/}" style="color:#fff; text-decoration:none;">STATELESS</a></div>

    <div class="min-vh-100 d-flex justify-content-center align-items-center py-4">
        <!-- Fragmento de contenido -->
        <div th:replace="${content}"></div>
    </div>

    <!-- El mismo script de animación de puntos/ondas que tenías -->
    <script>
        const canvas = document.getElementById('wavesCanvas');
        const ctx = canvas.getContext('2d');
        let w, h, dots = [];
        function resize() {
            w = canvas.width = window.innerWidth;
            h = canvas.height = window.innerHeight;
            dots = [];
            const spacing = 26;
            for (let x = 0; x < w + spacing; x += spacing) {
                for (let y = 0; y < h + spacing; y += spacing) {
                    dots.push({ baseX: x, baseY: y });
                }
            }
        }
        resize();
        window.addEventListener('resize', resize);
        let t = 0;
        function animate() {
            t += 0.012; ctx.clearRect(0, 0, w, h);
            for (const d of dots) {
                const dx = (d.baseX - w / 2) / w; const dy = (d.baseY - h / 2) / h;
                const dist = Math.sqrt(dx * dx + dy * dy);
                const wave = Math.sin(dist * 10 - t * 2) * 0.5 + 0.5;
                const size = 1 + wave * 2.2; const alpha = 0.12 + wave * 0.45;
                ctx.beginPath(); ctx.arc(d.baseX, d.baseY, size, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(255,255,255,${alpha})`; ctx.fill();
            }
            requestAnimationFrame(animate);
        }
        animate();
    </script>
</body>
</html>
</file>

<file path="src/main/resources/templates/producto/show.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" th:replace="~{layouts/app-layout :: layout(content=~{::section})}">
<body>
<section style="padding: 80px 60px; max-width:1200px; margin:0 auto;">
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:start;">

        <!-- CARRUSEL DE IMÁGENES -->
        <div style="position:relative; overflow:hidden;">
            <div id="producto-carousel" style="display:flex; transition:transform 0.4s ease;">
                <!-- Imagen principal -->
                <div style="min-width:100%; flex-shrink:0;">
                    <img th:src="${producto.imagen}"
                         style="width:100%; height:600px; object-fit:cover; display:block;">
                </div>
                <!-- Imágenes adicionales -->
                <div th:each="img : ${producto.imagenes}" style="min-width:100%; flex-shrink:0;">
                    <img th:src="${img.imagen}"
                         style="width:100%; height:600px; object-fit:cover; display:block;">
                </div>
            </div>
            <!-- Controles (Solo si hay más imágenes) -->
            <div th:if="${not #lists.isEmpty(producto.imagenes)}">
                <button onclick="moverProducto(-1)" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); background:rgba(0,0,0,0.5); color:#fff; border:none; width:40px; height:40px; cursor:pointer; z-index:10;">‹</button>
                <button onclick="moverProducto(1)" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:rgba(0,0,0,0.5); color:#fff; border:none; width:40px; height:40px; cursor:pointer; z-index:10;">›</button>
            </div>
        </div>

        <!-- INFO PRODUCTO -->
        <div>
            <p th:text="${producto.categoria.nombre}" style="font-size:11px; letter-spacing:3px; text-transform:uppercase; opacity:0.4; margin-bottom:12px;"></p>
            <h1 th:text="${producto.nombre}" style="font-family:'Bebas Neue', sans-serif; font-size:56px; letter-spacing:4px; margin-bottom:16px;"></h1>
            <p th:text="${'$' + #numbers.formatDecimal(producto.precio, 0, 'COMMA', 2, 'POINT')}" style="font-family:'Bebas Neue', sans-serif; font-size:36px; letter-spacing:2px; margin-bottom:24px;"></p>
            <p th:text="${producto.descripcion}" style="font-size:14px; line-height:1.8; opacity:0.7; margin-bottom:32px;"></p>

            <!-- SELECTOR DE VARIANTES (Integrado en la columna de info) -->
            <div th:if="${not #lists.isEmpty(producto.variantes)}" style="margin-bottom:32px; padding-top:20px; border-top:1px solid #eee;">
                <p style="font-size:11px; letter-spacing:3px; text-transform:uppercase; opacity:0.4; margin-bottom:12px;">
                    COLOR: <span id="color-nombre" style="color:#000; font-weight:600;">Original</span>
                </p>
                <div style="display:flex; gap:10px; flex-wrap:wrap;">
                    <!-- Círculo Original -->
                    <button th:onclick=" 'seleccionarVariante(\'Original\', \'' + ${producto.imagen} + '\', ' + ${producto.stockActual} + ')' "
                            style="width:36px; height:36px; border-radius:50%; border:3px solid #000; cursor:pointer; background: #eee;"></button>
                    
                    <!-- Círculos de Colores de Variantes -->
                    <button th:each="v : ${producto.variantes}"
                            th:onclick=" 'seleccionarVariante(\'' + ${v.color} + '\', \'' + ${v.imagen} + '\', ' + ${v.stockActual} + ')' "
                            th:style="'width:36px; height:36px; border-radius:50%; border:2px solid #ddd; cursor:pointer; background:' + ${v.hex}"></button>
                </div>
                <p id="variante-stock" style="font-size:12px; opacity:0.5; margin-top:10px;" th:text="'Stock: ' + ${producto.stockActual} + ' unidades'"></p>
            </div>

            <!-- BOTÓN CARRITO -->
            <form th:action="@{'/carrito/agregar/' + ${producto.id}}" method="POST">
                <button type="submit" class="btn-stateless" style="width:100%; padding:16px; font-size:13px;">
                    Añadir al carrito
                </button>
            </form>
            
            <div style="margin-top:32px; padding-top:24px; border-top:1px solid #eee;">
                <p style="font-size:11px; opacity:0.4;">Stock disponible general</p>
                <p th:text="${producto.stockActual + ' unidades'}" style="font-size:14px; font-weight:600;"></p>
            </div>
        </div>
    </div>

    <script th:inline="javascript">
        let productoIndex = 0;
        /*[# th:if="${not #lists.isEmpty(producto.imagenes)}"]*/
        const totalImagenes = [[${producto.imagenes.size() + 1}]];
        /*[/#]*/
        /*[# th:unless="${not #lists.isEmpty(producto.imagenes)}"]*/
        const totalImagenes = 1;
        /*[/#]*/

        function moverProducto(dir) {
            productoIndex = (productoIndex + dir + totalImagenes) % totalImagenes;
            document.getElementById('producto-carousel').style.transform = `translateX(-${productoIndex * 100}%)`;
        }

        function seleccionarVariante(nombre, imagenUrl, stock) {
            document.getElementById('color-nombre').innerText = nombre;
            if(stock !== null) {
                document.getElementById('variante-stock').innerText = 'Stock: ' + stock + ' unidades';
            }
            // Si la variante tiene imagen de Cloudinary, cambiamos el primer slide del carrusel
            if(imagenUrl && imagenUrl !== 'null') {
                const firstImg = document.querySelector('#producto-carousel img');
                if(firstImg) firstImg.src = imagenUrl;
                // Volver el carrusel al inicio para mostrar la imagen de la variante
                productoIndex = 0;
                document.getElementById('producto-carousel').style.transform = `translateX(0%)`;
            }
        }
    </script>
</section>
</body>
</html>
