<file path="src/main/resources/templates/cliente/pedidos/index.html">
package com.stateless.stateless.controller.web;

import com.stateless.stateless.model.User;
import com.stateless.stateless.model.Venta;
import com.stateless.stateless.repository.VentaRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.security.core.annotation.AuthenticationPrincipal;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.server.ResponseStatusException;
import org.springframework.http.HttpStatus;

import java.util.List;

@Controller
@RequestMapping("/account/pedidos")
public class ClientePedidoController {

    @Autowired
    private VentaRepository ventaRepository;

    @GetMapping
    public String index(@AuthenticationPrincipal User user, Model model) {
        List<Venta> ventas = ventaRepository.findByUsuarioIdOrderByCreated_atDesc(user.getId());
        model.addAttribute("ventas", ventas);
        return "cliente/pedidos/index";
    }

    @GetMapping("/{id}")
    public String show(@PathVariable Long id, @AuthenticationPrincipal User user, Model model) {
        Venta venta = ventaRepository.findById(id)
                .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND));

        // Verificación de seguridad: Solo el dueño puede ver el detalle
        if (!venta.getUsuario().getId().equals(user.getId())) {
            throw new ResponseStatusException(HttpStatus.FORBIDDEN);
        }

        model.addAttribute("venta", venta);
        return "cliente/pedidos/show";
    }
}
</file>

<file path="src/main/resources/templates/cliente/pedidos/show.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" th:replace="~{layouts/app-layout :: layout(content=~{::section})}">
<body>
<section style="padding:60px 40px; max-width:900px; margin:0 auto;">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:32px;">
        <div>
            <a th:href="@{/account/pedidos}" style="font-size:12px; opacity:0.5; text-decoration:none;">← Volver al historial</a>
            <h1 style="font-family:'Bebas Neue'; font-size:36px; letter-spacing:3px; margin-top:10px;" 
                th:text="'DETALLE PEDIDO #' + ${venta.id}"></h1>
        </div>
        <!-- Botón para volver a descargar la factura -->
        <a th:href="@{'/checkout/factura/' + ${venta.id} + '/descargar'}" class="btn-stateless">Descargar PDF</a>
    </div>

    <div style="background:#f9f9f9; padding:24px; border:1px solid #eee; margin-bottom:32px;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
            <div>
                <p style="font-size:10px; letter-spacing:2px; text-transform:uppercase; opacity:0.4;">Envío a:</p>
                <p th:text="${venta.envio.direccion + ', ' + venta.envio.ciudad}" style="font-size:14px; font-weight:600;"></p>
                <p th:text="'Estado Envío: ' + ${#strings.capitalize(venta.envio.estado)}" style="font-size:12px; opacity:0.6;"></p>
            </div>
            <div>
                <p style="font-size:10px; letter-spacing:2px; text-transform:uppercase; opacity:0.4;">Método de Pago:</p>
                <p th:text="${#strings.toUpperCase(venta.metodoPago)}" style="font-size:14px; font-weight:600;"></p>
            </div>
        </div>
    </div>

    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="border-bottom:2px solid #000;">
                <th style="text-align:left; padding:10px 0; font-size:11px; letter-spacing:2px; text-transform:uppercase;">Producto</th>
                <th style="text-align:center; padding:10px 0; font-size:11px; letter-spacing:2px; text-transform:uppercase;">Cant</th>
                <th style="text-align:right; padding:10px 0; font-size:11px; letter-spacing:2px; text-transform:uppercase;">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            <tr th:each="item : ${venta.items}" style="border-bottom:1px solid #eee;">
                <td style="padding:16px 0;">
                    <p th:text="${item.producto.nombre}" style="font-weight:600; margin:0;"></p>
                    <p th:text="${'$' + item.precioUnitario}" style="font-size:12px; opacity:0.5; margin:0;"></p>
                </td>
                <td th:text="${item.cantidad}" style="text-align:center;"></td>
                <td th:text="${'$' + #numbers.formatDecimal(item.precioUnitario * item.cantidad, 0, 'COMMA', 2, 'POINT')}" 
                    style="text-align:right; font-weight:600;"></td>
            </tr>
        </tbody>
        <tfoot>
            <tr>
                <td colspan="2" style="padding:20px 0; font-family:'Bebas Neue'; font-size:24px;">TOTAL</td>
                <td th:text="${'$' + #numbers.formatDecimal(venta.total, 0, 'COMMA', 2, 'POINT')}" 
                    style="text-align:right; font-family:'Bebas Neue'; font-size:24px; padding:20px 0;"></td>
            </tr>
        </tfoot>
    </table>

</section>
</body>
</html>
</file>

<file path="src/main/resources/templates/ecommerce/buscar.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" th:replace="~{layouts/app-layout :: layout(content=~{::section})}">
<body>
<section style="padding: 60px 40px; max-width: 1200px; margin: 0 auto;">

    <h1 style="font-family:'Bebas Neue'; font-size:42px; letter-spacing:4px; margin-bottom:40px;">CATÁLOGO COMPLETO</h1>

    <!-- FORMULARIO DE FILTROS (Equivalente a tu buscador lateral) -->
    <form th:action="@{/catalogo}" method="GET" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:20px; background:#f9f9f9; padding:24px; border:1px solid #eee; margin-bottom:48px;">
        
        <div>
            <label class="sl-label">Palabra clave</label>
            <input type="text" name="q" th:value="${query}" class="sl-input" placeholder="Camiseta, gorra...">
        </div>

        <div>
            <label class="sl-label">Categoría</label>
            <select name="cat" class="sl-input">
                <option value="">Todas</option>
                <option th:each="c : ${categorias}" th:value="${c.id}" th:text="${c.nombre}" th:selected="${c.id == catSeleccionada}"></option>
            </select>
        </div>

        <div>
            <label class="sl-label">Precio Máximo</label>
            <input type="number" name="max" th:value="${maxPrecio}" class="sl-input" placeholder="Ej: 100000">
        </div>

        <div style="display:flex; align-items:center; gap:10px; padding-top:25px;">
            <input type="checkbox" name="disponible" value="true" th:checked="${soloDisponible}" id="chk-disp">
            <label for="chk-disp" style="font-size:12px; letter-spacing:1px; cursor:pointer;">SOLO DISPONIBLES</label>
        </div>

        <div style="padding-top:20px;">
            <button type="submit" class="btn-stateless" style="width:100%;">FILTRAR</button>
        </div>
    </form>

    <!-- GRID DE PRODUCTOS -->
    <p th:text="${productos.size() + ' PRODUCTOS ENCONTRADOS'}" style="font-size:11px; letter-spacing:2px; opacity:0.4; margin-bottom:24px;"></p>
    
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:32px;">
        <div th:each="p : ${productos}" style="border:1px solid #eee; padding:16px; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#000'" onmouseout="this.style.borderColor='#eee'">
            <a th:href="@{'/producto/' + ${p.id}}" style="text-decoration:none; color:inherit;">
                <img th:src="${p.imagen}" style="width:100%; aspect-ratio:3/4; object-fit:cover; margin-bottom:16px;">
                <p th:text="${p.categoria.nombre}" style="font-size:10px; opacity:0.5; letter-spacing:2px; text-transform:uppercase; margin-bottom:4px;"></p>
                <p th:text="${p.nombre}" style="font-family:'Bebas Neue'; font-size:20px; letter-spacing:1px; margin-bottom:8px;"></p>
                <p th:text="${'$' + #numbers.formatDecimal(p.precio, 0, 'COMMA', 0, 'POINT')}" style="font-weight:600;"></p>
            </a>
            
            <form th:action="@{'/carrito/agregar/' + ${p.id}}" method="POST" style="margin-top:16px;">
                <button type="submit" class="btn-sl-outline" style="width:100%;" th:disabled="${p.stockActual == 0}" th:text="${p.stockActual > 0 ? 'AÑADIR AL CARRITO' : 'AGOTADO'}"></button>
            </form>
        </div>
    </div>

    <div th:if="${#lists.isEmpty(productos)}" style="text-align:center; padding:80px 0;">
        <p style="opacity:0.3; font-family:'Bebas Neue'; font-size:24px;">No se encontraron productos con esos filtros.</p>
        <a th:href="@{/catalogo}" style="color:#000; font-size:12px; letter-spacing:2px;">LIMPIAR FILTROS</a>
    </div>

</section>
</body>
</html>
</file>

